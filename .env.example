# Local overrides and secrets. Copy to .env for Docker Compose host ports.

# PostgreSQL official image
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Ledger / write-side DB
LEDGER_DB_HOST=localhost
LEDGER_DB_PORT=28436
LEDGER_DB_USER=ledger_app
LEDGER_DB_PASSWORD=change-me-ledger
LEDGER_DB_NAME=salestracker_ledger
LEDGER_DB_SSLMODE=disable

# Analytics / read-side DB
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=28436
ANALYTICS_DB_USER=analytics_app
ANALYTICS_DB_PASSWORD=change-me-analytics
ANALYTICS_DB_NAME=salestracker_analytics
ANALYTICS_DB_SSLMODE=disable

SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10

APP_ENV=development
APP_LOG_LEVEL=debug

# Docker host ports
APP_HTTP_PORT=8081
POSTGRES_HOST_PORT=28436
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# JWT auth for protected API routes.
SECURITY_JWT_SECRET=replace-with-long-random-jwt-secret
SECURITY_JWT_TTL=1h

# Optional legacy fallback for local/dev migration only.
# Format: token:user_id:role[,token:user_id:role]
SECURITY_AUTH_TOKENS=replace-with-long-random-token:11111111-1111-1111-1111-111111111111:operator
MONITORING_LARGE_AMOUNT_THRESHOLD=100000
